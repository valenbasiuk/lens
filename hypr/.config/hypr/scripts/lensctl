#!/bin/bash

# =============================================================================
# lensctl — lens settings panel
# launched from waybar button or SUPER+COMMA
#
# sections:
# - mouse sensitivity
# - wallpaper picker
# - keybind reference
# - wifi (nm-connection-editor)
# - bluetooth (blueman-manager)
# - audio (pavucontrol)
# - display / theming (nwg-look)
# - quick toggles (blur, opacity, gaps, reloads)
# =============================================================================

HYPR_CONF="$HOME/.config/hypr/hyprland.conf"
HYPR_KEYS="$HOME/.config/hypr/keybinds.conf"
WALLPAPER_DIR="$HOME/Pictures/wallpapers"
ROFI_THEME="$HOME/.config/rofi/theme.rasi"

rofi_menu() {
    rofi -dmenu -theme "$ROFI_THEME" "$@"
}

# =============================================================================
# MAIN MENU
# =============================================================================

main_menu() {
    local choice
    choice=$(printf \
        "mouse sensitivity\nwallpaper\nkeybinds\nwifi\nbluetooth\naudio\ndisplay / theming\nquick toggles\nexit" \
        | rofi_menu -p "lens settings" -no-custom -i)

    case "$choice" in
        "mouse sensitivity")  menu_mouse ;;
        "wallpaper")          menu_wallpaper ;;
        "keybinds")           menu_keybinds ;;
        "wifi")               nm-connection-editor & ;;
        "bluetooth")          blueman-manager & ;;
        "audio")              pavucontrol & ;;
        "display / theming")  nwg-look & ;;
        "quick toggles")      menu_toggles ;;
        "exit"|"")            exit 0 ;;
    esac
}

# =============================================================================
# MOUSE SENSITIVITY
# hyprland range: -1.0 (slowest) to 1.0 (fastest) | 0.0 = raw input
#
# speedrunning reference (800 DPI):
#   -0.94 hyprland = ~32cm/360 = ~150 DPI effective (Windows 10 default cursor speed)
# =============================================================================

menu_mouse() {
    local current_sens
    current_sens=$(grep -oP '(?<=sensitivity = )[-0-9.]+' "$HYPR_CONF" 2>/dev/null | head -1)
    current_sens="${current_sens:-0}"

    local choice
    choice=$(printf \
        "custom value\n-0.94  speedrunning preset (800 DPI, ~150 DPI Windows equivalent)\n-0.75  low sens gaming (800 DPI)\n-0.50  moderate low sens\n 0.00  raw input (no accel)\n 0.50  moderate high sens\n 1.00  maximum sensitivity" \
        | rofi_menu \
            -p "mouse sensitivity" \
            -no-custom \
            -mesg "current: $current_sens  |  range: -1.0 (slow) to 1.0 (fast)")

    local new_sens
    case "$choice" in
        "custom value")
            new_sens=$(printf "" | rofi_menu \
                -p "enter value (-1.0 to 1.0)" \
                -mesg "current: $current_sens  |  speedrunning preset: -0.94")
            ;;
        "-0.94"*) new_sens="-0.94" ;;
        "-0.75"*) new_sens="-0.75" ;;
        "-0.50"*) new_sens="-0.50" ;;
        " 0.00"*) new_sens="0" ;;
        " 0.50"*) new_sens="0.50" ;;
        " 1.00"*) new_sens="1" ;;
        "")       return ;;
    esac

    if [[ -n "$new_sens" ]]; then
        if [[ "$new_sens" =~ ^-?[0-9]+(\.[0-9]+)?$ ]]; then
            hyprctl keyword input:sensitivity "$new_sens"
            sed -i "s/sensitivity = .*/sensitivity = $new_sens/" "$HYPR_CONF"
            notify-send "lens" "mouse sensitivity: $new_sens" -a "lensctl"
        else
            notify-send "lens" "invalid value: $new_sens" -a "lensctl" -u critical
        fi
    fi
}

# =============================================================================
# WALLPAPER PICKER
# lists images in ~/Pictures/wallpapers, applies with hyprpaper live
# =============================================================================

menu_wallpaper() {
    mkdir -p "$WALLPAPER_DIR"

    local wallpapers
    mapfile -t wallpapers < <(find "$WALLPAPER_DIR" -type f \
        \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" -o -iname "*.webp" \) \
        2>/dev/null | sort)

    if [[ ${#wallpapers[@]} -eq 0 ]]; then
        notify-send "lens" "no wallpapers in $WALLPAPER_DIR" \
            -a "lensctl" -b "open folder" \
            && thunar "$WALLPAPER_DIR" &
        return
    fi

    local names
    names=$(printf '%s\n' "${wallpapers[@]}" | xargs -I{} basename {})

    local choice
    choice=$(echo "$names" | rofi_menu \
        -p "wallpaper" \
        -mesg "$WALLPAPER_DIR  |  ${#wallpapers[@]} images found")

    if [[ -n "$choice" ]]; then
        local full_path="$WALLPAPER_DIR/$choice"
        if [[ -f "$full_path" ]]; then
            # apply to all connected monitors
            while IFS= read -r monitor; do
                hyprctl hyprpaper unload all 2>/dev/null
                hyprctl hyprpaper preload "$full_path"
                hyprctl hyprpaper wallpaper "$monitor,$full_path"
            done < <(hyprctl monitors -j | jq -r '.[].name')
            notify-send "lens" "wallpaper: $choice" -a "lensctl"
        fi
    fi
}

# =============================================================================
# KEYBIND REFERENCE
# =============================================================================

menu_keybinds() {
    local choice
    choice=$(printf \
        "view keybinds\nedit keybinds\nedit hyprland.conf" \
        | rofi_menu -p "keybinds" -no-custom)

    case "$choice" in
        "view keybinds")
            kitty --title "keybinds" -e bash -c \
                "bat --style=full '$HYPR_KEYS' 2>/dev/null || cat '$HYPR_KEYS'; read -p 'press enter to close'" &
            ;;
        "edit keybinds")
            kitty --title "keybinds.conf" -e "${EDITOR:-nvim}" "$HYPR_KEYS" &
            ;;
        "edit hyprland.conf")
            kitty --title "hyprland.conf" -e "${EDITOR:-nvim}" "$HYPR_CONF" &
            ;;
    esac
}

# =============================================================================
# QUICK TOGGLES
# =============================================================================

menu_toggles() {
    # read live state from hyprctl where possible
    local blur_int
    blur_int=$(hyprctl getoption decoration:blur:enabled -j 2>/dev/null | jq -r '.int // 1')
    local blur_label
    [[ "$blur_int" == "1" ]] && blur_label="blur      ON   toggle off" \
                              || blur_label="blur      OFF  toggle on"

    local opacity
    opacity=$(hyprctl getoption decoration:active_opacity -j 2>/dev/null | jq -r '.float // 0.9')
    local opacity_label
    # truncate to 2 decimal places for comparison
    local opacity_short
    opacity_short=$(printf "%.2f" "$opacity" 2>/dev/null || echo "0.90")
    [[ "$opacity_short" == "1.00" ]] \
        && opacity_label="opacity   1.0  restore glass (0.90)" \
        || opacity_label="opacity   $opacity_short  set opaque (1.0)"

    local gaps_out
    gaps_out=$(hyprctl getoption general:gaps_out -j 2>/dev/null | jq -r '.int // 14')
    local gaps_label
    [[ "$gaps_out" == "0" ]] \
        && gaps_label="gaps      OFF  restore (6/14)" \
        || gaps_label="gaps      ${gaps_out}px   toggle off"

    local choice
    choice=$(printf \
        "$blur_label\n$opacity_label\n$gaps_label\n---\nreload waybar\nreload hyprpaper\nrestart hyprland" \
        | rofi_menu -p "quick toggles" -no-custom)

    case "$choice" in
        "blur      ON"*)
            hyprctl keyword decoration:blur:enabled false
            notify-send "lens" "blur off" -a "lensctl"
            ;;
        "blur      OFF"*)
            hyprctl keyword decoration:blur:enabled true
            notify-send "lens" "blur on" -a "lensctl"
            ;;
        "opacity"*"set opaque"*)
            hyprctl keyword decoration:active_opacity 1
            hyprctl keyword decoration:inactive_opacity 1
            notify-send "lens" "opacity: opaque" -a "lensctl"
            ;;
        "opacity"*"restore glass"*)
            hyprctl keyword decoration:active_opacity 0.90
            hyprctl keyword decoration:inactive_opacity 0.85
            notify-send "lens" "opacity: glass restored" -a "lensctl"
            ;;
        "gaps"*"toggle off"*)
            hyprctl keyword general:gaps_in 0
            hyprctl keyword general:gaps_out 0
            notify-send "lens" "gaps off" -a "lensctl"
            ;;
        "gaps"*"restore"*)
            hyprctl keyword general:gaps_in 6
            hyprctl keyword general:gaps_out 14
            notify-send "lens" "gaps restored" -a "lensctl"
            ;;
        "reload waybar")
            killall waybar 2>/dev/null; waybar & disown
            notify-send "lens" "waybar reloaded" -a "lensctl"
            ;;
        "reload hyprpaper")
            killall hyprpaper 2>/dev/null; hyprpaper & disown
            notify-send "lens" "hyprpaper reloaded" -a "lensctl"
            ;;
        "restart hyprland")
            hyprctl dispatch exit
            ;;
    esac
}

# =============================================================================
# ENTRY POINT
# =============================================================================

main_menu
