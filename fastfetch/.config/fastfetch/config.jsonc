{
    "logo": {
        "type": "small",
        "color": {
            "1": "36"
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "36",
            "output": "37"
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "{user-name}@{host-name}",
            "key": " "
        },
        {
            "type": "separator",
            "string": "─"
        },
        {
            "type": "os",
            "key": "os"
        },
        {
            "type": "kernel",
            "key": "kernel"
        },
        {
            "type": "packages",
            "key": "pkgs"
        },
        {
            "type": "shell",
            "key": "shell"
        },
        {
            "type": "wm",
            "key": "wm"
        },
        {
            "type": "terminal",
            "key": "term"
        },
        {
            "type": "cpu",
            "key": "cpu"
        },
        {
            "type": "gpu",
            "key": "gpu",
            "hideType": "integrated"
        },
        {
            "type": "memory",
            "key": "mem"
        },
        {
            "type": "disk",
            "key": "disk",
            "folders": "/"
        },
        {
            "type": "uptime",
            "key": "up"
        },
        {
            "type": "separator",
            "string": "─"
        },
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        }
    ]
}
