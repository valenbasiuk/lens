/* =============================================================================
   lens - rofi theme.rasi
   frutiger aero / windows 7 aero glass aesthetic
   ============================================================================= */

* {
    /* aero glass colors: glossy cyan, emerald green, crisp glass white */
    bg-glass:        rgba(12, 38, 56, 0.82);
    bg-header:       rgba(0, 104, 132, 0.65);
    bg-input:        rgba(4, 28, 42, 0.75);
    bg-selected:     rgba(0, 172, 215, 0.45);
    
    fg:              #ffffff;
    fg-dim:          rgba(224, 247, 250, 0.70);
    accent-cyan:     #00e5ff;
    accent-green:    #7ed957;
    urgent:          #ff5252;

    border-glass:    rgba(255, 255, 255, 0.55);
    border-subtle:   rgba(0, 229, 255, 0.35);

    font:            "Inter Medium 11";
}

/* --- main window --- */
window {
    width:            520px;
    border:           2px solid;
    border-color:     @border-glass;
    border-radius:    16px;
    background-color: @bg-glass;
    padding:          0px;

    /* real glass transparency */
    transparency:     "real";
}

/* --- container box --- */
mainbox {
    background-color: transparent;
    children:         [ inputbar, message, listview ];
    spacing:          10px;
    padding:          16px;
}

/* --- header search bar (win7 aero style) --- */
inputbar {
    background-color: @bg-header;
    border:           1px solid;
    border-color:     rgba(255, 255, 255, 0.65);
    border-radius:    10px;
    padding:          10px 14px;
    spacing:          10px;
    children:         [ prompt, entry ];
}

prompt {
    background-color: transparent;
    text-color:       @accent-green;
    font:             "Inter Bold 11";
}

entry {
    background-color: transparent;
    text-color:       @fg;
    placeholder:      "search apps & settings...";
    placeholder-color: @fg-dim;
}

/* --- results list --- */
listview {
    background-color: transparent;
    columns:          1;
    lines:            8;
    spacing:          4px;
    fixed-height:     false;
    scrollbar:        false;
}

/* --- list elements --- */
element {
    background-color: transparent;
    text-color:       @fg;
    padding:          8px 12px;
    border-radius:    8px;
    spacing:          12px;
}

element normal.normal {
    background-color: transparent;
}

element selected.normal {
    background-color: @bg-selected;
    border:           1px solid;
    border-color:     rgba(255, 255, 255, 0.70);
    text-color:       #ffffff;
}

element alternate.normal {
    background-color: transparent;
}

element-icon {
    background-color: transparent;
    size:             28px;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
    font:             "Inter Medium 11";
}

/* --- message / text boxes --- */
message {
    background-color: transparent;
    border:           0;
    margin:           0px 0px 4px 0px;
}

textbox {
    background-color: @bg-input;
    border:           1px solid;
    border-color:     @border-subtle;
    text-color:       @accent-cyan;
    padding:          8px 12px;
    border-radius:    8px;
    font:             "Inter 10";
}
